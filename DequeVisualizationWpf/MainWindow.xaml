<Window x:Class="DequeVisualizationWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DequeVisualizationWpf"
        mc:Ignorable="d"
        Title="Визуализация дека (двусвязный список)"
        Height="600" Width="1000" MinHeight="400" MinWidth="700">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:DequeCommands.AddFirst}"
                        Executed="AddFirstExecuted"/>
        <CommandBinding Command="{x:Static local:DequeCommands.AddLast}"
                        Executed="AddLastExecuted"/>
        <CommandBinding Command="{x:Static local:DequeCommands.RemoveFirst}"
                        Executed="RemoveFirstExecuted" CanExecute="RemoveCanExecute"/>
        <CommandBinding Command="{x:Static local:DequeCommands.RemoveLast}"
                        Executed="RemoveLastExecuted" CanExecute="RemoveCanExecute"/>
        <CommandBinding Command="{x:Static local:DequeCommands.Description}"
                        Executed="DescriptionExecuted"/>
        <CommandBinding Command="Save" Executed="SaveExecuted"/>
        <CommandBinding Command="Open" Executed="OpenExecuted"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"  MinHeight="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <MediaElement x:Name="media" Grid.Row="0" Width="0" Height="0"
                      Source="Sounds/node.wav"
                      LoadedBehavior="Manual" UnloadedBehavior="Close"
                      MediaFailed="media_MediaFailed"/>

        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Сохранить..." Command="Save"/>
                <MenuItem Header="Загрузить..." Command="Open"/>
            </MenuItem>
            <MenuItem Header="Алгоритм">
                <MenuItem Command="{x:Static local:DequeCommands.Description}"/>
            </MenuItem>
            <MenuItem Header="Звук">
                <MenuItem Header="Включить" IsCheckable="True" IsChecked="True"
                          x:Name="menuSound"/>
            </MenuItem>
        </Menu>

        <DockPanel Grid.Row="1" Margin="5" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Label Content="Значение:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtInput"
                         Width="{StaticResource InputWidth}"
                         Margin="{StaticResource ElementMargin}"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
            <WrapPanel>
                <Button Command="{x:Static local:DequeCommands.AddFirst}"
                        Content="Добавить в начало"/>
                <Button Command="{x:Static local:DequeCommands.AddLast}"
                        Content="Добавить в конец"/>
                <Button Command="{x:Static local:DequeCommands.RemoveFirst}"
                        Content="Удалить из начала"/>
                <Button Command="{x:Static local:DequeCommands.RemoveLast}"
                        Content="Удалить с конца"/>
            </WrapPanel>
        </DockPanel>

        <ScrollViewer x:Name="scrollDeque" Grid.Row="2" Margin="5"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      SizeChanged="scrollDeque_SizeChanged">
            <Canvas x:Name="canvasDeque"
                    Background="{StaticResource CanvasBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MinWidth="400" MinHeight="120"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,0,10,4">
            <Rectangle Width="18" Height="12"
                       Fill="{StaticResource NodeBrush}"
                       Stroke="{StaticResource NodeBorderBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="узел дека" Style="{StaticResource LegendText}"/>

            <Canvas Width="24" Height="12" VerticalAlignment="Center">
                <Line X1="0" Y1="6" X2="24" Y2="6"
                      Stroke="{StaticResource LinkBrush}" StrokeThickness="2"/>
            </Canvas>
            <TextBlock Text="связь next / prev" Style="{StaticResource LegendText}"/>

            <Ellipse Width="12" Height="12"
                     Fill="{StaticResource HeadBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="head" Style="{StaticResource LegendText}"/>

            <Ellipse Width="12" Height="12"
                     Fill="{StaticResource TailBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="tail" Style="{StaticResource LegendText}"/>
        </StackPanel>

        <GridSplitter Grid.Row="4" Height="4"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ShowsPreview="False"/>

        <ScrollViewer x:Name="scrollLog" Grid.Row="5" Margin="5"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="listLog"/>
        </ScrollViewer>

        <Grid Grid.Row="6" Margin="5,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="txtCount"
                       Style="{StaticResource StatusText}" Text="Элементов: 0"/>
            <TextBlock Grid.Column="1" x:Name="txtPointers"
                       Style="{StaticResource StatusText}" Text="HEAD: —   TAIL: —"/>
        </Grid>
    </Grid>
</Window>
