<Window x:Class="DequeVisualizationWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DequeVisualizationWpf"
        mc:Ignorable="d"
        Title="Визуализация дека (двусвязный список)"
        Height="600" Width="1000" MinHeight="400" MinWidth="700">


    <Grid ShowGridLines="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="3*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"  MinHeight="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Сохранить..."/>
                <MenuItem Header="Загрузить..."/>
            </MenuItem>
            <MenuItem Header="Алгоритм">
                <MenuItem Header="Описание"/>
            </MenuItem>
        </Menu>


        <DockPanel Grid.Row="1" Margin="5" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Label Content="Значение:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtInput" Width="80" Margin="3"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
            <WrapPanel>
                <Button Margin="3" Padding="8,4">Добавить в начало</Button>
                <Button Margin="3" Padding="8,4">Добавить в конец</Button>
                <Button Margin="3" Padding="8,4">Удалить из начала</Button>
                <Button Margin="3" Padding="8,4">Удалить с конца</Button>
            </WrapPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="2" Margin="5"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="canvasDeque" Background="WhiteSmoke"
                    MinWidth="400" MinHeight="120"/>
        </ScrollViewer>

        <GridSplitter Grid.Row="3" Height="4"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ShowsPreview="False"/>

        <ScrollViewer Grid.Row="4" Margin="5" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="listLog"/>
        </ScrollViewer>

        <Grid Grid.Row="5" Margin="5,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="txtCount" Text="Элементов: 0"/>
            <TextBlock Grid.Column="1" x:Name="txtPointers" Text="HEAD: —   TAIL: —"/>
        </Grid>
    </Grid>
</Window>
