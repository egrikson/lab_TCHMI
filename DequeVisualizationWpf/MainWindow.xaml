<Window x:Class="DequeVisualizationWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DequeVisualizationWpf"
        mc:Ignorable="d"
        Title="Визуализация дека (двусвязный список)"
        Height="600" Width="1000" MinHeight="400" MinWidth="700">

    <!-- Каркас окна: пять логических областей, разделённых строками Grid -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>               <!-- 1. меню -->
            <RowDefinition Height="Auto"/>               <!-- 2. панель операций -->
            <RowDefinition Height="3*" MinHeight="150"/> <!-- 3. визуализация дека -->
            <RowDefinition Height="Auto"/>               <!-- разделитель -->
            <RowDefinition Height="*"  MinHeight="80"/>  <!-- 4. журнал событий -->
            <RowDefinition Height="Auto"/>               <!-- 5. строка состояния -->
        </Grid.RowDefinitions>

        <!-- 1. Меню -->
        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Сохранить..." Click="menuSave_Click"/>
                <MenuItem Header="Загрузить..." Click="menuLoad_Click"/>
            </MenuItem>
            <MenuItem Header="Алгоритм">
                <MenuItem Header="Описание" Click="menuDescription_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. Панель операций: поле ввода прижато влево,
             кнопки занимают оставшееся место и переносятся при сужении окна -->
        <DockPanel Grid.Row="1" Margin="5" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Label Content="Значение:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtInput" Width="80" Margin="3"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
            <WrapPanel>
                <Button Margin="3" Padding="8,4" Click="btnAddFront_Click">Добавить в начало</Button>
                <Button Margin="3" Padding="8,4" Click="btnAddBack_Click">Добавить в конец</Button>
                <Button Margin="3" Padding="8,4" Click="btnRemoveFront_Click">Удалить из начала</Button>
                <Button Margin="3" Padding="8,4" Click="btnRemoveBack_Click">Удалить с конца</Button>
            </WrapPanel>
        </DockPanel>

        <!-- 3. Область визуализации дека.
             Canvas — поверхность рисования узлов и связей, прокрутка вынесена
             в ScrollViewer, так как контейнеры компоновки её не поддерживают -->
        <ScrollViewer x:Name="scrollDeque" Grid.Row="2" Margin="5"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      SizeChanged="scrollDeque_SizeChanged">
            <Canvas x:Name="canvasDeque" Background="WhiteSmoke"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MinWidth="400" MinHeight="120"/>
        </ScrollViewer>

        <!-- Разделитель между областью визуализации и журналом -->
        <GridSplitter Grid.Row="3" Height="4"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ShowsPreview="False"/>

        <!-- 4. Журнал событий -->
        <ScrollViewer x:Name="scrollLog" Grid.Row="4" Margin="5"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="listLog"/>
        </ScrollViewer>

        <!-- 5. Строка состояния: счётчик слева, указатели справа -->
        <Grid Grid.Row="5" Margin="5,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="txtCount" Text="Элементов: 0"/>
            <TextBlock Grid.Column="1" x:Name="txtPointers" Text="HEAD: —   TAIL: —"/>
        </Grid>
    </Grid>
</Window>
