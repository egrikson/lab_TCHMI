<Application x:Class="DequeVisualizationWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:DequeVisualizationWpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="NodeBrush" Color="White"/>
        <SolidColorBrush x:Key="NodeAddedBrush" Color="LightYellow"/>
        <SolidColorBrush x:Key="NodeHighlightBrush" Color="LightGreen"/>
        <SolidColorBrush x:Key="NodeBorderBrush" Color="Black"/>
        <SolidColorBrush x:Key="LinkBrush" Color="Black"/>
        <SolidColorBrush x:Key="HeadBrush" Color="Red"/>
        <SolidColorBrush x:Key="TailBrush" Color="Gray"/>
        <SolidColorBrush x:Key="HoverBrush" Color="DarkRed"/>

        <LinearGradientBrush x:Key="CanvasBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White" Offset="0"/>
            <GradientStop Color="Gainsboro" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="PointerBrush">
            <GradientStop Color="White" Offset="0"/>
            <GradientStop Color="Gainsboro" Offset="1"/>
        </RadialGradientBrush>

        <sys:Double x:Key="InputWidth">80</sys:Double>
        <Thickness x:Key="ElementMargin">3</Thickness>
        <Thickness x:Key="ButtonPadding">8,4</Thickness>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="{StaticResource ElementMargin}"/>
            <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
            <Setter Property="MinWidth" Value="140"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="DimGray"/>
        </Style>

        <Style x:Key="LegendText" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
            <Setter Property="Margin" Value="4,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NodeStyle" TargetType="Border">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{StaticResource NodeBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NodeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Application.Resources>
</Application>
